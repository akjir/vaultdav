{
    "compilerOptions": {
        "isolatedModules": true,
        "lib": [
            "DOM",
            "ES2022"
        ],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "noEmit": true,
        "noImplicitAny": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "strict": true,
        "strictNullChecks": true,
        "target": "ES2022",
        "types": []
    },
    "include": [
        "src/**/*.ts",
        "tests/**/*.ts"
    ]
}
